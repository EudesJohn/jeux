; Modele de configuration de Godot 4.x. Reglages imposes par DESIGN.md § 4
; (rendu Compatibility OpenGL ES 3.0 pour couvrir les anciens telephones) et § 19 (couches).

config_version=5

[application]

config/name="Guerrière d'Abomey"
config/description="Action-aventure 3D low-poly hors ligne, inspirée du royaume du Dahomey."
config/author="Johnson Studio"
config/copyright="© 2026 Johnson Studio"
config/version="0.1.0"
run/main_scene="res://scenes/main/Splash.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.101961, 0.078431, 0.066667, 1)
boot_splash/show_image=false
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://autoload/Events.gd"
GameState="*res://autoload/GameState.gd"
SaveManager="*res://autoload/SaveManager.gd"
Settings="*res://autoload/Settings.gd"
AudioManager="*res://autoload/AudioManager.gd"
FX="*res://autoload/FX.gd"
DailySeed="*res://autoload/DailySeed.gd"
Network="*res://autoload/Network.gd"
AttackTokenManager="*res://autoload/AttackTokenManager.gd"
Achievements="*res://autoload/Achievements.gd"
Quality="*res://autoload/Quality.gd"
AutoTest="*res://scripts/debug/AutoTest.gd"
Localizer="*res://autoload/Localizer.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="fr"
locale/translations=PackedStringArray("res://assets/i18n/fr.po", "res://assets/i18n/en.po", "res://assets/i18n/fon.po")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="hazard"
3d_physics/layer_7="pickup"
3d_physics/layer_8="interactable"
3d_physics/layer_9="camera_block"

[physics]

common/physics_ticks_per_second=60

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
scaling_3d/mode=0
scaling_3d/scale=0.8
textures/vram_compression/import_etc2_astc=true
